# Copy to ~/.config/find-your-sole/api.env and fill in the values there (chmod 600).
# Never commit the filled-in file. Quote values that contain spaces or shell characters.
# The same names as the Render API service; see AGENTS.md "Environment".

ANTHROPIC_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Same Neon Postgres URL the Render API uses (feedback + catalogue prices).
DATABASE_URL=
ADMIN_TOKEN=
# Set to 1 only if it is already 1 on Render (after a successful catalogue sync).
CATALOG_PRICES_ENABLED=

# Optional, as on Render:
# ALLOWED_ORIGINS=
# EXPLAIN_PER_CLIENT=10
# FEEDBACK_PER_CLIENT=5
# NEWS_TTL_SECONDS=10800
